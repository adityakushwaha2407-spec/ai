n=8
board=[-1]*n

def solve(row):
    if row==n:
        return True
    
    for col in range(n):
        safe=True
        
        for r in range(row):
            if board[r]==col or abs(board[r]-col)==abs(row-r):
                safe=False
        
        if safe:
            board[row]=col
            
            if solve(row+1):
                return True
    return False

solve(0)

print("Solution:")

for row in range(n):
    for col in range(n):
        if board[row]==col:
            print("Q", end=" ")
        else:
            print("_", end=" ")
    print()
