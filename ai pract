simulated annealing

import random
import math

values=[10,15,12,20,18]
current=0
temp=100

while temp>1:
    nextstate=random.randint(0, len(values)-1)
    
    if values[nextstate]>values[current]:
        current=nextstate
    else:
        probability=math.exp((values[nextstate]-values[current])/temp)
        
        if random.random()<probability:
            current=nextstate
            
    temp=temp*0.9

print("Best value found: ", values[current])




