graph={
    'A':{'B':1,'C':4},
    'B':{'D':2,'E':5},
    'C':{'F':3},
    'D':{},
    'E':{'G':2},
    'F':{'G':2},
    'G':{},
}

h={
    'A':5,'B':4,'C':3,'D':4,'E':2,'F':1,'G':0
}

openlist=['A']
cost={'A':0}
parent={}

while openlist:
    n=min(openlist,key=lambda x: cost[x]+h[x])
    openlist.remove(n)
    
    if n=='G':
        break
    
    for v in graph[n]:
        c= cost[n] + graph[n][v]
        if v not in cost or c < cost[v]:
            cost[v]=c
            parent[v]=n
            if v not in openlist:
                openlist.append(v)

path=['G']
while path[-1] != 'A':
    path.append(parent[path[-1]])
path.reverse()

print("Shortest Path: ",path)
print("Total Cost: ",cost['G'])



