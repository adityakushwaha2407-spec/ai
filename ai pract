def ab(depth, node, maximizing, values, alpha, beta):
    if depth == 3:
        return values[node]

    if maximizing:
        best = -999
        for i in range(2):
            value = ab(depth+1, node*2+i, False,
                       values, alpha, beta)
            best = max(best, value)
            alpha = max(alpha, best)
            if beta <= alpha:
                break
        return best

    else:
        best = 999
        for i in range(2):
            value = ab(depth+1, node*2+i, True,
                       values, alpha, beta)
            best = min(best, value)
            beta = min(beta, best)
            if beta <= alpha:
                break
        return best

values = [3, 5, 9, 6, 1, 2, 0, -1]
result = ab(0, 0, True, values, -999, 999)
print("Optimal value:", result)




